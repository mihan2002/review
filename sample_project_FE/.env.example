# Base URL of the Diary REST API.
#
# Recommended for local development: keep the relative path and let the Vite dev
# server proxy /api to the Spring Boot backend (no CORS configuration required).
VITE_API_BASE_URL=/api

# Backend the dev proxy forwards to.
VITE_API_PROXY_TARGET=http://localhost:8080

# Alternatively, call the backend directly. This requires CORS to be enabled on
# the backend for the frontend origin:
# VITE_API_BASE_URL=http://localhost:8080/api
