# Copy to .env and replace every value. Never commit the real .env.

# --- PostgreSQL ---
DB_NAME=diarydb
DB_USERNAME=diary
DB_PASSWORD=change-me-strong-password
# Host/port used by the application (docker compose overrides DB_HOST to "postgres")
DB_HOST=localhost
DB_PORT=5432
# Host port that PostgreSQL is published on by docker compose
DB_PORT_HOST=5432

# --- Application ---
SERVER_PORT=8080
# Hibernate schema handling: update (dev) | validate | none
JPA_DDL_AUTO=update

# --- JWT ---
# HMAC-SHA key, at least 32 characters. Generate one, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Token lifetime in seconds (86400 = 24 hours)
JWT_EXPIRATION=86400
