# Copy to .env and replace every value. Never commit the real .env.

# --- PostgreSQL ---
DB_NAME=diarydb
DB_USERNAME=diary
DB_PASSWORD=change-me-strong-password
# Host/port used by the application (docker compose overrides DB_HOST to "postgres")
DB_HOST=localhost
DB_PORT=5432
# Host port that PostgreSQL is published on by docker compose
DB_PORT_HOST=5432

# --- Application ---
SERVER_PORT=8080
# Hibernate schema handling: update (dev) | validate | none
JPA_DDL_AUTO=update

# --- JWT ---
# HMAC-SHA key, at least 32 characters. Generate one, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Token lifetime in seconds (86400 = 24 hours)
JWT_EXPIRATION=86400

# --- Mail (password reset PINs) ---
# Gmail address the reset emails are sent from.
MAIL_USERNAME=your.address@gmail.com
# Google App Password (16 characters, NOT your Gmail password):
#   Google Account > Security > 2-Step Verification > App passwords
# Leave this BLANK to run without email: no mail is sent, the reset PIN is
# fixed to RESET_DEV_PIN below and written to the server log.
MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# --- Password reset ---
# How long a PIN stays valid, in minutes.
RESET_PIN_TTL_MINUTES=15
# Wrong-PIN tries allowed before the PIN is burned.
RESET_PIN_MAX_ATTEMPTS=5
# Fallback PIN used only when MAIL_PASSWORD is blank.
RESET_DEV_PIN=1234
